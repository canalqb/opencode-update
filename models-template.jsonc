{
  "$schema": "https://opencode.ai/config.json",
  // opencode-update (canalqb) - template with the 26 free models of the NVIDIA integrate API
  // How to get your FREE API key: https://build.nvidia.com -> Sign in -> "Get API Key"
  // The installer replaces PASTE-YOUR-NVIDIA-API-KEY-HERE automatically when you pass
  // -NvidiaApiKey, set the NVIDIA_API_KEY environment variable, or answers the prompt.
  // Main model ("big")
  "model": "nvidia/z-ai/glm-5.3",
  // Small model for titles/summaries ("small")
  "small_model": "nvidia/nvidia/llama-3.1-nemotron-nano-8b-v1",
  "provider": {
    "nvidia": {
      "type": "openai",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "PASTE-YOUR-NVIDIA-API-KEY-HERE"
      },
      "models": {
        "z-ai/glm-5.3": {
          "name": "GLM-5.3 (Z.ai)",
          "limit": { "context": 262144, "output": 262144 },
          "reasoning": true
        },
